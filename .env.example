# Copy the names below into ignored .dev.vars for local Worker testing.
# Use test-mode provider credentials only. Never commit .dev.vars.
RESEND_API_KEY=replace-with-resend-test-key
RESEND_FROM_EMAIL=replace-with-verified-sender@example.com
PAYSTACK_PUBLIC_KEY=pk_test_replace-with-test-key
PAYSTACK_SECRET_KEY=sk_test_replace-with-test-key
APP_BASE_URL=http://127.0.0.1:8787
# Reserved for post-deployment Google OAuth setup, not used in Tasks 1-4.
GOOGLE_CLIENT_ID=replace-after-deployment
GOOGLE_CLIENT_SECRET=replace-after-deployment
